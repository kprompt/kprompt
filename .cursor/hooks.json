{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/gofmt.sh",
        "timeout": 30
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/branch-name.sh",
        "matcher": "checkout\\s+-b|switch\\s+-[cC]|git\\s+branch",
        "timeout": 10
      }
    ]
  }
}
